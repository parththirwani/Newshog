DATABASE_URL=postgresql://newshog:newshog@localhost:5432/newshog
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=your-openrouter-api-key-here

# HMAC secret for signed session + anon_id cookies. Rotate before launch.
# REQUIRED in production: the app 500s on any signing operation without it.
SESSION_SECRET=long-random-string-here

# Upstash Redis for the A.1 rate limiter (REST proxy — safe from serverless).
# When unset, fail-closed routes (analyze/deep/auth) 503 in production, so
# these must be set before launch. Get both from the Upstash dashboard.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe billing (Pro tier, $20/mo). Create the recurring price once in the
# Stripe dashboard and paste its id here. Billing routes answer
# 503 billing_unconfigured when these are unset, so the rest of the app
# works without them during development.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# IMAP credentials for journalist digest email ingestion
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password

# Medialyst funnel link (external app). CTA hides when unset.
NEXT_PUBLIC_MEDIALYST_URL=
# Web scraping fallback for gated/paywalled pages (plain-text mirror).
JINA_API_KEY=

# LinkedIn profile scraping via Apify (atomus/linkedin-profile-scraper).
# $0.006/profile, 20 free/month, success-only billing. Get a token at
# https://console.apify.com/settings/integrations
APIFY_TOKEN=

# X (Twitter) API v2 — requires a funded pay-per-use key (~$0.01/user lookup).
# Must be the OAuth2 App Access Token (Bearer, starts with AAAA...) from the
# "Keys and tokens" tab — NOT the short API Key/consumer key.
# https://developer.x.com/en/portal/dashboard
X_API_KEY=

# Deep Research
# Optional override for the DuckDuckGo HTML search endpoint.
DDG_SEARCH_URL=https://html.duckduckgo.com/html/
# Hard per-run ceiling (prompt+completion tokens). Set empirically after one real
# 3-thread/depth-2 run — sanity check, then tune up/down.
MAX_RUN_TOKENS=300000
# Enforce deep-research gating/quota for Deep Research (/api/analyze/deep,
# /api/deep-research, /prepare). Set to "false" only in dev/tests to exercise
# the pipeline without a pro account. UNSET is prod-safe: enforcement defaults
# ON in production so a missing flag can never silently unlock paid LLM spend.
ENABLE_PRO_GATING=true
