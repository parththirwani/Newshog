generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisStatus {
  queued
  scraping
  scraped
  analyzing
  analyzed
  failed
}

enum ExtractionMode {
  full
  limited
}

enum ProfileType {
  individual
  enterprise
}

enum SourcePlatform {
  source_of_sources
  help_a_b2b_writer
  sourcebottle
}

model Profile {
  id         String      @id @default(cuid())
  type       ProfileType
  ownerEmail String      @unique @map("owner_email")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  individual IndividualProfile?
  enterprise EnterpriseProfile?
  analyses   Analysis[]

  @@map("profiles")
}

model IndividualProfile {
  profileId        String  @id @map("profile_id")
  linkedinUrl      String? @map("linkedin_url")
  xHandle          String? @map("x_handle")
  freeTextBio      String? @map("free_text_bio")
  xRawData         Json?   @map("x_raw_data")
  expertiseSummary Json?   @map("expertise_summary")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("individual_profiles")
}

model EnterpriseProfile {
  profileId          String    @id @map("profile_id")
  companyName        String    @map("company_name")
  companyDescription String?   @map("company_description")
  websiteUrl         String?   @map("website_url")
  docsUrl            String?   @map("docs_url")
  pdfText            String?   @map("pdf_text")
  websiteRawText     String?   @map("website_raw_text")
  companyContext     Json?     @map("company_context")
  lastCrawledAt      DateTime? @map("last_crawled_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("enterprise_profiles")
}

model Token {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tokens")
}

model Analysis {
  id             String         @id @default(cuid())
  url            String
  status         AnalysisStatus @default(queued)
  articleTitle   String?        @map("article_title")
  rawArticleText String?        @map("raw_article_text")
  extractionMode ExtractionMode? @map("extraction_mode")
  score          Int?
  angles         Json?
  whyNow         String?        @map("why_now")
  pitch          String?
  error          String?
  profileId      String?        @map("profile_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  profile Profile? @relation(fields: [profileId], references: [id])
  matches AnalysisJournalistMatch[]

  @@map("analyses")
}

model JournalistRequest {
  id              String         @id @default(cuid())
  sourcePlatform  SourcePlatform @map("source_platform")
  requesterName   String?        @map("requester_name")
  outlet          String?
  topicText       String         @map("topic_text")
  deadline        DateTime?
  replyContact    String?        @map("reply_contact")
  rawEmailRef     String?        @map("raw_email_ref")
  ingestedAt      DateTime       @default(now()) @map("ingested_at")
  expiresAt       DateTime?      @map("expires_at")

  matches AnalysisJournalistMatch[]

  @@map("journalist_requests")
}

model AnalysisJournalistMatch {
  analysisId          String @map("analysis_id")
  journalistRequestId String @map("journalist_request_id")
  matchRationale      String @map("match_rationale")
  matchedAt           DateTime @default(now()) @map("matched_at")

  analysis          Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  journalistRequest JournalistRequest @relation(fields: [journalistRequestId], references: [id], onDelete: Cascade)

  @@id([analysisId, journalistRequestId])
  @@map("analysis_journalist_matches")
}

model Event {
  id        String   @id @default(cuid())
  name      String
  props     Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name])
  @@map("events")
}
