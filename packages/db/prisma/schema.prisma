generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UsageKind {
  quick_search
  deep_research
}

enum AnalysisStatus {
  queued
  scraping
  scraped
  researching
  analyzing
  analyzed
  failed
}

enum ExtractionMode {
  full
  limited
}

enum ProfileType {
  individual
  enterprise
}

enum SourcePlatform {
  source_of_sources
  help_a_b2b_writer
  sourcebottle
  haro
  qwoted
  mentionmatch
  pressplugs
}

enum DeepResearchStatus {
  queued
  running
  completed
  cancelled
  failed
  truncated
  low_confidence
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  createdAt   DateTime  @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")
  tier        String    @default("free")

  // Stripe billing state. tier/stripe_* are driven ONLY by the billing
  // webhook (checkout.session.completed / customer.subscription.updated /
  // customer.subscription.deleted) — there is no client-settable field.
  // Cancellation semantics: tier flips back to "free" on
  // customer.subscription.deleted (which Stripe fires at the actual
  // cancellation moment, honoring cancel-at-period-end where set in the
  // billing portal). invoice.payment_failed does NOT downgrade — Stripe
  // dunning retries for a grace period; only a real cancel reverts tier.
  stripeCustomerId          String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId      String?   @unique @map("stripe_subscription_id")
  stripeCurrentPeriodStart  DateTime? @map("stripe_current_period_start")
  stripeCurrentPeriodEnd    DateTime? @map("stripe_current_period_end")

  profiles      Profile[]
  analyses      Analysis[]
  usageCounters UsageCounter[]

  @@map("users")
}

model Profile {
  id        String      @id @default(cuid())
  type      ProfileType
  userId    String      @unique @map("user_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  individual IndividualProfile?
  enterprise EnterpriseProfile?
  analyses   Analysis[]

  @@map("profiles")
}

model IndividualProfile {
  profileId        String  @id @map("profile_id")
  linkedinUrl      String? @map("linkedin_url")
  xHandle          String? @map("x_handle")
  freeTextBio      String? @map("free_text_bio")
  xRawData         Json?   @map("x_raw_data")
  expertiseSummary Json?   @map("expertise_summary")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("individual_profiles")
}

model EnterpriseProfile {
  profileId          String    @id @map("profile_id")
  companyName        String    @map("company_name")
  companyDescription String?   @map("company_description")
  websiteUrl         String?   @map("website_url")
  docsUrl            String?   @map("docs_url")
  pdfText            String?   @map("pdf_text")
  websiteRawText     String?   @map("website_raw_text")
  companyContext     Json?     @map("company_context")
  lastCrawledAt      DateTime? @map("last_crawled_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("enterprise_profiles")
}

model Token {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tokens")
}

model Analysis {
  id                String          @id @default(cuid())
  url               String
  status            AnalysisStatus  @default(queued)
  articleTitle      String?         @map("article_title")
  rawArticleText    String?         @map("raw_article_text")
  extractionMode    ExtractionMode? @map("extraction_mode")
  score             Int?
  // ponytail: free-string velocity column, not a check constraint or enum —
  // lets new categories ship without a migration. Ceiling: garbage can sneak
  // in; app falls back to "standard". Promote to enum when categories freeze.
  velocity          String?
  velocityReasoning String?         @map("velocity_reasoning")
  angles            Json?
  whyNow            String?         @map("why_now")
  pitch             String?
  // ponytail: editable blog/post drafts live in one Json column ({ blog,
  // post, postPlatform }) instead of two columns — no per-kind queries exist.
  // Ceiling: promote to columns when drafts are searched or aggregated.
  drafts            Json?           @map("drafts")
  error             String?
  profileId         String?         @map("profile_id")
  userId            String?         @map("user_id")
  anonId            String?         @map("anon_id")
  researchRunId     String?         @map("research_run_id")
  sourcePublishedAt DateTime?       @map("source_published_at")
  eventTiming       String?         @map("event_timing")
  coverageSignal    Json?           @map("coverage_signal")
  noveltyScore      Int?            @map("novelty_score")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  profile  Profile?                 @relation(fields: [profileId], references: [id])
  user     User?                    @relation(fields: [userId], references: [id])
  run      DeepResearchRun?         @relation(fields: [researchRunId], references: [runId])
  matches  AnalysisJournalistMatch[]
  llmCalls LLMCall[]

  @@index([url, profileId, status])
  @@index([userId, createdAt])
  @@index([anonId, createdAt])
  @@map("analyses")
}

model LLMCall {
  id               String   @id @default(cuid())
  stage            String
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  analysisId       String?  @map("analysis_id")
  createdAt        DateTime @default(now()) @map("created_at")

  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([stage, createdAt])
  @@map("llm_calls")
}

model JournalistRequest {
  id             String         @id @default(cuid())
  sourcePlatform SourcePlatform @map("source_platform")
  requesterName  String?        @map("requester_name")
  outlet         String?
  topicText      String         @map("topic_text")
  deadline       DateTime?
  replyContact   String?        @map("reply_contact")
  rawEmailRef    String?        @map("raw_email_ref")
  ingestedAt     DateTime       @default(now()) @map("ingested_at")
  expiresAt      DateTime?      @map("expires_at")

  matches AnalysisJournalistMatch[]

  @@map("journalist_requests")
}

model AnalysisJournalistMatch {
  analysisId          String   @map("analysis_id")
  journalistRequestId String   @map("journalist_request_id")
  matchRationale      String   @map("match_rationale")
  matchedAt           DateTime @default(now()) @map("matched_at")

  analysis          Analysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  journalistRequest JournalistRequest @relation(fields: [journalistRequestId], references: [id], onDelete: Cascade)

  @@id([analysisId, journalistRequestId])
  @@map("analysis_journalist_matches")
}

model Event {
  id        String   @id @default(cuid())
  name      String
  props     Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name])
  @@map("events")
}

// ── Usage quotas ──────────────────────────────────────────────
// Two independent counters per identity, one per usage kind. Quick search and
// deep research never share a bucket. Anonymous usage is tracked SEPARATELY (no
// user row) via AnonymousUsage; logged-in users (free/pro) via UsageCounter.

// ponytail: anonymous counters are intentionally lifetime-only, no period
// column. Anon limits are flat (3 quick lifetime, 0 deep) so a period is dead
// weight. Ceiling: a "weekly anon refresh" tier would need period_start/end +
// a unique tweak here — a contained migration, not a redesign.
model AnonymousUsage {
  id        String    @id @default(cuid())
  anonId    String    @map("anon_id")
  kind      UsageKind
  count     Int       @default(0)
  firstSeen DateTime  @default(now()) @map("first_seen")
  lastSeen  DateTime  @default(now()) @map("last_seen")

  @@unique([anonId, kind])
  @@map("anonymous_usage")
}

// Logged-in usage. period_start/period_end are the daily UTC boundary for the
// free tier and the Stripe billing cycle for pro. Rows are created lazily on
// first hit in a period; consumption is a single atomic upsert keyed on
// (user_id, kind, period_start) with a count < limit guard — no transaction,
// no SELECT ... FOR UPDATE, no race window.
model UsageCounter {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  kind        UsageKind
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  count       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodStart])
  @@map("usage_counters")
}

// ── Deep Research ─────────────────────────────────────────────

model DeepResearchRun {
  id              String             @id @default(cuid())
  runId           String             @unique
  status          DeepResearchStatus @default(queued)
  userId          String?            @map("user_id")
  query           String
  depth           Int                @default(2)
  breadth         Int                @default(3)
  mode            String             @default("answer")
  prepareSessionId String?           @map("prepare_session_id")
  skipClarification Boolean          @default(false) @map("skip_clarification")
  clarificationAnswers Json?         @map("clarification_answers")
  coveredQueries   Json              @default("[]") @map("covered_queries")
  learnings        Json              @default("[]")
  sources          Json              @default("[]")
  visitedUrls      Json              @default("[]") @map("visited_urls")
  answer           String?
  report           String?
  promptTokens     Int               @default(0) @map("prompt_tokens")
  completionTokens Int               @default(0) @map("completion_tokens")
  estimatedCostUsd Float?            @map("estimated_cost_usd")
  error            String?
  cancelled        Boolean           @default(false)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  analyses Analysis[]

  @@index([status, updatedAt])
  @@map("deep_research_runs")
}

model DeepResearchSession {
  id        String   @id @default(cuid())
  query     String
  questions Json
  answers   Json?
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("deep_research_sessions")
}
